#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") [-h] repo_url ..."
  echo "     : do git clone <repo_url> ..."
  echo " -h  : show this help message and exit"
}
while getopts "h" arg; do
  case $arg in
    h)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

if ! command -v git &>/dev/null; then
  echo "Error: git is not installed. Please install it to run this script."
  exit 1
fi
if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi
for url in "$@"; do
  if ! git clone "$url"; then
    echo "Error: failed to clone $url"
    exit 1
  fi
done

exit 0